DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/crop_health
# Comma-separated explicit browser origins; replace with the deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Uvicorn settings used by scripts/start_backend.cmd; direct Uvicorn CLI flags also work.
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info
# Production inference assets (the smoke checkpoint is intentionally not accepted).
# CROP_HEALTH_MODEL_CHECKPOINT=models/classifier/production/efficientnet_b0_best.pt
# CROP_HEALTH_CLASS_MAPPING=models/classifier/production/class_mapping.json
# CROP_HEALTH_MODEL_VERSION=efficientnet_b0_production
# CROP_HEALTH_DEVICE=cpu
WEATHER_API_BASE_URL=https://api.open-meteo.com
# Optional overrides. Geocoding uses its separate Open-Meteo host by default.
# WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_TIMEOUT_SECONDS=8
VITE_API_BASE_URL=
